# LLM
# Provider is set in config.yaml (llm.provider). To override per environment
# (e.g. Cloud Run), set LLM_PROVIDER — it wins over config.yaml. Leave it unset
# locally so config.yaml is the single source of truth.
# LLM_PROVIDER=google
GOOGLE_API_KEY=your_api_key_here

# OpenAI-compatible providers (see config.yaml "providers:")
OPENCODE_API_KEY=your_opencode_go_key_here   # https://opencode.ai/auth

# PostgreSQL (+ pgvector) — local Docker or managed (Neon/Supabase)
DATABASE_URL=postgresql://aifinder:aifinder_pass@localhost:5432/aifinder

# Neo4j graph — local Docker or managed (Neo4j AuraDB Free)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aifinder_pass

# NiceGUI session secret (any random string)
STORAGE_SECRET=change_me_random_string

# Cloudinary (image upload scripts only; not needed by the NiceGUI app)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
